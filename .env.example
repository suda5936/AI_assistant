# 하네스 메일 알림 설정. 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git에 올라가지 않고 에이전트는 읽을 수 없다).
#   cp .env.example .env
# 네이버 메일: 메일 > 환경설정 > POP3/IMAP 설정에서 "IMAP/SMTP 사용"을 켠다.
# 2단계 인증을 쓰면 네이버 보안설정 > 애플리케이션 비밀번호를 만들어 아래 PASSWORD에 넣는다.
HARNESS_SMTP_HOST=smtp.naver.com
HARNESS_SMTP_PORT=465
HARNESS_SMTP_USER=
HARNESS_SMTP_PASSWORD=
# 받는 주소 (비워 두면 .claude/harness.json 의 notify.to 를 쓴다)
HARNESS_NOTIFY_TO=
