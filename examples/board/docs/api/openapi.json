        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldErrorOut",
        "description": "필드별 오류."
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "로그인 요청."
      },
      "PostOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "author": {
            "$ref": "#/components/schemas/AuthorOut"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
