        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "$ref": "#/components/schemas/AuthorOut"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "created_at"
        ],
        "title": "PostSummaryOut",
        "description": "목록 항목 응답."
      },
      "PostWriteRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "PostWriteRequest",
        "description": "글 작성·수정 요청. 길이 검증은 서비스가 맡는다."
      },
      "SignupRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "SignupRequest",
        "description": "회원가입 요청. 검증은 services/validation.py가 맡는다."
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "created_at"
        ],
        "title": "UserOut",
        "description": "사용자 응답. 비밀번호 관련 필드를 두지 않는다."
      }
    }
  }
}
