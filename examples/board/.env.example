# 복사해서 .env로 쓴다: cp .env.example .env (실제 .env는 커밋하지 않는다)

# [backend] SQLAlchemy DB URL. 상대 경로는 backend/ 기준이다.
DATABASE_URL=sqlite:///./board.db

# [backend] true/1/yes면 세션 쿠키에 Secure 속성을 붙인다 (HTTPS 환경). false/0/no/빈 값이면 끈다.
SESSION_COOKIE_SECURE=false

# [frontend] 개발 서버가 /api 요청을 넘길 백엔드 주소 (vite.config.ts)
API_PROXY_TARGET=http://127.0.0.1:8000

# [frontend] API 기본 URL. 비우면 같은 출처를 쓴다.
VITE_API_BASE_URL=
